# macOS
.DS_Store

# Python
.venv/
__pycache__/
*.pyc

# SDD scratch
.superpowers/

# claude — everything here is local EXCEPT the one skill that belongs to this
# repo. Written as .claude/* rather than .claude/, because git cannot
# re-include a path whose parent directory is excluded: `!` on a child of an
# ignored directory does nothing at all.
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/verify-commercial-use/

# local secrets, never committed
.secret

# SDD design docs (local only)
docs/superpowers/
